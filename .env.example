# apps/web/.env.local
# `vercel env pull` (run in apps/web) fills in the database variables.

# Postgres (Neon via Vercel Marketplace)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Better Auth: generate a secret with `openssl rand -base64 32`
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional: GitHub sign-in (https://github.com/settings/developers → OAuth Apps)
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Private key for realtime board tokens: `pnpm realtime-keys local` in apps/web
# (also writes the public key to apps/realtime/.dev.vars)
REALTIME_TOKEN_PRIVATE_KEY=

# Host of the realtime Worker (`pnpm dev` runs it on port 8787)
NEXT_PUBLIC_REALTIME_HOST=localhost:8787

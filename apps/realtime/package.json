{
  "name": "@planwerk/realtime",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "build": "wrangler deploy --dry-run --outdir dist",
    "typegen": "wrangler types",
    "lint": "eslint .",
    "typecheck": "wrangler types && tsc --noEmit && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@planwerk/shared": "workspace:*",
    "partyserver": "^0.5.10",
    "y-partyserver": "^2.2.0",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "jose": "^6.2.15",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0",
    "wrangler": "^4.158.0"
  }
}

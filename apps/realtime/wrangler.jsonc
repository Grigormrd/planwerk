{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planwerk-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BoardRoom",
        "class_name": "BoardRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"],
    },
  ],
}

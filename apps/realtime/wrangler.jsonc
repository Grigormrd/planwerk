{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "planwerk-realtime",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "observability": {
    "enabled": true,
  },
  "vars": {
    // Public half of the key the web app signs board tokens with. Not a secret.
    // Empty means every connection is refused. Set by `pnpm realtime-keys production`
    // in apps/web; local development overrides it in .dev.vars.
    "REALTIME_TOKEN_PUBLIC_KEY": "",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "BoardRoom",
        "class_name": "BoardRoom",
      },
    ],
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["BoardRoom"],
    },
  ],
}

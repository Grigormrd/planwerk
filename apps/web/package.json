{
  "name": "@planwerk/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node scripts/migrate.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "dotenv -e .env.local -- node scripts/migrate.mjs",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "realtime-keys": "node scripts/realtime-keys.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@neondatabase/serverless": "^1.2.0",
    "@planwerk/shared": "workspace:*",
    "@tiptap/core": "^3.33.0",
    "@tiptap/extension-collaboration": "^3.33.0",
    "@tiptap/extension-collaboration-caret": "^3.33.0",
    "@tiptap/extensions": "^3.33.0",
    "@tiptap/pm": "^3.33.0",
    "@tiptap/react": "^3.33.0",
    "@tiptap/starter-kit": "^3.33.0",
    "@tiptap/y-tiptap": "^3.2.0",
    "better-auth": "^1.7.18",
    "drizzle-orm": "^0.45.4",
    "jose": "^6.2.15",
    "next": "16.4.5",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "^0.0.1",
    "y-indexeddb": "^9.0.12",
    "y-partyserver": "^2.2.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.33",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.1.0",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.5",
    "fake-indexeddb": "^6.2.7",
    "tailwindcss": "^4",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  }
